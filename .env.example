BOT_TOKEN=your_bot_token_here
API_ID=your_api_id_here
API_HASH=your_api_hash_here
STORAGE_CHANNEL_ID=your_storage_channel_id_here
WEBAPP_URL=https://your-public-url.com

# Use a long random value. Do not reuse BOT_TOKEN.
SECRET_KEY=replace_with_at_least_32_random_bytes
SESSION_COOKIE_NAME=telefilm_session
SESSION_TTL_SECONDS=43200
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_PARTITIONED=true

ALLOWED_TELEGRAM_IDS=id1,id2
ADMIN_TELEGRAM_IDS=id1

# Comma-separated absolute Windows paths that admin upload is allowed to scan.
UPLOAD_ROOTS=H:\\Movies
UPLOAD_SPEED_LIMIT_MB=2

STREAM_TOKEN_TTL_SECONDS=21600
STREAM_TOKEN_RATE_PER_MINUTE=30
STREAM_REQUEST_RATE_PER_MINUTE=300
MAX_CONCURRENT_STREAMS_PER_USER=6

ENABLE_API_DOCS=false
DATABASE_URL=sqlite+aiosqlite:///./telegram_film.db
